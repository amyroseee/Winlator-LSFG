@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#pragma once
+
+#include "../vulkan/vulkan.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace lsfgvk::advisory {
+    enum class PresetName { Unknown, Performance, Balanced, Quality };
+    enum class RecommendationConfidence { Low, Medium, High };
+
+    struct PresetRecommendation {
+        PresetName name{PresetName::Unknown};
+        float flowScaleMin{};
+        float flowScaleMax{};
+        bool performanceMode{true};
+        uint32_t multiplierMin{2};
+        uint32_t multiplierMax{4};
+        RecommendationConfidence confidence{RecommendationConfidence::Low};
+        std::vector<std::string> reasons{};
+        std::vector<std::string> warnings{};
+    };
+
+    struct PresetRecommendations {
+        PresetName preferred{PresetName::Unknown};
+        RecommendationConfidence confidence{RecommendationConfidence::Low};
+        std::vector<PresetRecommendation> presets{};
+        std::vector<std::string> reasons{};
+        std::vector<std::string> warnings{};
+    };
+
+    /// Build advisory-only presets from static GPU capabilities. Never mutates configuration.
+    [[nodiscard]] PresetRecommendations getPresetRecommendations(
+        const vk::GpuCapabilities& capabilities);
+    void printPresetRecommendations(const PresetRecommendations& recommendations);
+}
diff --git a/lsfg-vk-common/src/helpers/presets.cpp b/lsfg-vk-common/src/helpers/presets.cpp
new file mode 100644
index 0000000..b77ab2f
--- /dev/null
+++ b/lsfg-vk-common/src/helpers/presets.cpp
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include "lsfg-vk-common/helpers/presets.hpp"
+
+#include <iostream>
+
+using namespace lsfgvk::advisory;
+
+namespace {
+    const char* presetName(PresetName name) {
+        switch (name) {
+            case PresetName::Performance: return "PERFORMANCE";
+            case PresetName::Balanced: return "BALANCED";
+            case PresetName::Quality: return "QUALITY";
+            default: return "UNKNOWN";
+        }
+    }
+
+    const char* confidenceName(RecommendationConfidence confidence) {
+        switch (confidence) {
+            case RecommendationConfidence::High: return "HIGH";
+            case RecommendationConfidence::Medium: return "MEDIUM";
+            default: return "LOW";
+        }
+    }
+
+    PresetRecommendation performancePreset(const vk::GpuCapabilities& capabilities) {
+        PresetRecommendation result{
+            .name = PresetName::Performance,
+            .flowScaleMin = 0.20F,
+            .flowScaleMax = 0.35F,
+            .performanceMode = true,
+            .confidence = capabilities.supported ?
+                RecommendationConfidence::Medium : RecommendationConfidence::Low,
+            .reasons = {
+                "lowest-cost advisory range for the current flow-resolution model",
+                "Performance Mode ON is the validated path"
+            },
+            .warnings = {
+                "lower flow resolution can reduce edge precision",
+                "multiplier remains manual and must be validated per game"
+            }
+        };
+        if (!capabilities.fp16)
+            result.reasons.emplace_back("FP32 fallback benefits from the conservative cost target");
+        return result;
+    }
+
+    PresetRecommendation balancedPreset(const vk::GpuCapabilities& capabilities) {
+        PresetRecommendation result{
+            .name = PresetName::Balanced,
+            .flowScaleMin = 0.35F,
+            .flowScaleMax = 0.50F,
+            .performanceMode = true,
+            .confidence = RecommendationConfidence::Low,
+            .reasons = {
+                "moderate flow-resolution range while preserving the validated shader path"
+            },
+            .warnings = {
+                "static capabilities do not measure game FPS, GPU headroom or latency",
+                "multiplier remains manual and 2x should be validated first"
+            }
+        };
+        if (capabilities.fp16)
+            result.reasons.emplace_back("FP16 shader path is available");
+        else
+            result.warnings.emplace_back("FP16 unavailable; FP32 may increase GPU cost");
+        return result;
+    }
+
+    PresetRecommendation qualityPreset(const vk::GpuCapabilities& capabilities) {
+        PresetRecommendation result{
+            .name = PresetName::Quality,
+            .flowScaleMin = 0.50F,
+            .flowScaleMax = 0.80F,
+            .performanceMode = true,
+            .confidence = RecommendationConfidence::Low,
+            .reasons = {
+                "higher flow resolution can improve motion-field and edge precision",
+                "Performance Mode ON preserves the stable host path"
+            },
+            .warnings = {
+                "Performance Mode OFF is a known unstable path and is never recommended",
+                "higher flow resolution can reduce base FPS and increase latency",
+                "actual visual quality depends on temporal input and game content"
+            }
+        };
+        if (!capabilities.memoryBudgetAvailable)
+            result.warnings.emplace_back("memory budget unavailable; headroom is unknown");
+        if (!capabilities.fp16)
+            result.warnings.emplace_back("FP16 unavailable; Quality cost uses FP32 fallback");
+        return result;
+    }
+}
+
+PresetRecommendations lsfgvk::advisory::getPresetRecommendations(
+        const vk::GpuCapabilities& capabilities) {
+    PresetRecommendations result{};
+    result.presets.reserve(3);
+    result.presets.emplace_back(performancePreset(capabilities));
+    result.presets.emplace_back(balancedPreset(capabilities));
+    result.presets.emplace_back(qualityPreset(capabilities));
+
+    result.warnings.emplace_back("advisory only; user configuration is never changed");
+    result.warnings.emplace_back("actual game FPS, temporal stability and input latency are unknown");
+    result.warnings.emplace_back("multiplier remains a manual user choice");
+    if (!capabilities.memoryBudgetAvailable)
+        result.warnings.emplace_back("memory budget unavailable");
+    if (!capabilities.supported) {
+        result.reasons.emplace_back("required capability evaluation reported missing requirements");
+        return result;
+    }
+
+    // Static capabilities cannot predict a game's headroom. Prefer only the lowest-cost
+    // validated path; Balanced and Quality remain visible advisory alternatives.
+    result.preferred = PresetName::Performance;
+    result.confidence = RecommendationConfidence::Medium;
+    result.reasons.emplace_back("required static capabilities are available");
+    result.reasons.emplace_back("runtime FPS/headroom are unknown, so conservative cost is preferred");
+    if (capabilities.fp16)
+        result.reasons.emplace_back("FP16 path is available");
+    return result;
+}
+
+void lsfgvk::advisory::printPresetRecommendations(
+        const PresetRecommendations& recommendations) {
+    std::cerr << "lsfg-vk: Advisory preset: preferred="
+        << presetName(recommendations.preferred)
+        << ", confidence=" << confidenceName(recommendations.confidence)
+        << ", applied=false, performance_mode_off=unstable\n";
+}
